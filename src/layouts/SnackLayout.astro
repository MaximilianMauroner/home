---
import FontmatterTagsList from "@/components/content/FontmatterTagsList.astro";
import PostImageLoader from "@/components/content/PostImageLoader.astro";
import ReadingProgress from "@/components/content/ReadingProgress";
import RelatedPosts from "@/components/content/RelatedPosts.astro";
import TableOfContents from "@/components/content/TableOfContents";
import { timeAgo } from "@/utils/helpers";
import { getArticleOgImageUrl, getArticleTrail } from "@/utils/server/content";
import type { HeadingType } from "@/utils/types";
import StarLayout from "./StarLayout.astro";
import "./SnackLayout.css";

interface Props {
  frontmatter: {
    title: string;
    description?: string;
    tags?: string[];
    releaseDate: Date | string;
    image?: string;
    lastModified?: string;
    minutesRead?: string;
  };
  headings?: HeadingType[];
}

const { frontmatter, headings = [] } = Astro.props;
const releaseDate = new Date(frontmatter.releaseDate);
const articleModifiedTime = frontmatter.lastModified
  ? new Date(frontmatter.lastModified).toISOString()
  : releaseDate.toISOString();
const publishedDateLabel = releaseDate.toLocaleDateString("en-US", {
  month: "long",
  day: "numeric",
  year: "numeric",
  timeZone: "UTC",
});
const updatedDateLabel = new Date(articleModifiedTime).toLocaleDateString(
  "en-US",
  {
    month: "long",
    day: "numeric",
    year: "numeric",
    timeZone: "UTC",
  },
);
const slugFromPath = Astro.url.pathname
  .replace(/^\/snacks\//, "")
  .replace(/\/$/, "");
const titleTransitionName = `snack-title-${slugFromPath.replaceAll("/", "-") || "snack"}`;
const entryCode = (slugFromPath.split("-")[0] || "note")
  .replace(/[^a-zA-Z0-9]/g, "")
  .slice(0, 4)
  .toUpperCase();
const articleTrail = slugFromPath
  ? await getArticleTrail("snacks", slugFromPath)
  : { related: [] };
const ogImageUrl = getArticleOgImageUrl(Astro.url.pathname, Astro.site);
const tags = frontmatter.tags ?? [];
---

<StarLayout
  description={frontmatter.description || ""}
  title={frontmatter.title}
  image={frontmatter.image}
  ogImageUrl={ogImageUrl}
  articlePublishedTime={releaseDate.toISOString()}
  articleModifiedTime={articleModifiedTime}
  articleAuthor="Maximilian Mauroner"
>
  <ReadingProgress family="snack" client:load />

  <div class="snack-detail animate-fade-in motion-reduce:animate-none">
    <header class="snack-detail__paper snack-detail__hero">
      <div class="snack-detail__meta">
        <span class="snack-detail__family"><i aria-hidden="true"></i>Snack</span>
        <span>SNK—{entryCode}</span>
      </div>

      <div class="snack-detail__visual" aria-hidden="true">
        {
          frontmatter.image && (
            <div class="snack-detail__image">
              <PostImageLoader
                imagePath={frontmatter.image}
                altText=""
                className="h-full w-full object-cover"
              />
            </div>
          )
        }
        <div class="snack-detail__doodle"><i></i><i></i><i></i></div>
        <span class="snack-detail__mark">✦</span>
      </div>

      <div class="snack-detail__intro">
        <div class="snack-detail__date">
          <time datetime={releaseDate.toISOString()}>{publishedDateLabel}</time>
          <span>{timeAgo(releaseDate)}</span>
        </div>
        <h1 transition:name={titleTransitionName}>{frontmatter.title}</h1>
        {
          frontmatter.description && (
            <p>{frontmatter.description}</p>
          )
        }
      </div>

      <footer class="snack-detail__footer">
        {
          tags.length > 0 && (
            <div class="snack-detail__tags">
              <FontmatterTagsList tags={tags} />
            </div>
          )
        }
        <div class="snack-detail__reading-meta" aria-label="Article details">
          {frontmatter.minutesRead && <span>{frontmatter.minutesRead}</span>}
          <span>Updated {updatedDateLabel}</span>
        </div>
      </footer>
    </header>

    <article class="snack-detail__paper snack-detail__article">
      <header class="snack-detail__article-header" aria-hidden="true">
        <span>Note body</span>
        <span>Keep reading ↓</span>
      </header>
      <div class="snack-detail__prose prose prose-lg max-w-none dark:prose-invert">
        <slot />
      </div>
    </article>

    {
      headings.length > 0 && (
        <TableOfContents headingsArr={headings} family="snack" client:idle />
      )
    }
  </div>

  <RelatedPosts
    family="snack"
    previous={articleTrail.previous}
    next={articleTrail.next}
    items={articleTrail.related}
  />
</StarLayout>
