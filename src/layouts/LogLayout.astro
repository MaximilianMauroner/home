---
import FontmatterTagsList from "@/components/content/FontmatterTagsList.astro";
import ArticleJsonLd from "@/components/content/ArticleJsonLd.astro";
import PostImageLoader from "@/components/content/PostImageLoader.astro";
import ReadingProgress from "@/components/content/ReadingProgress";
import RelatedPosts from "@/components/content/RelatedPosts.astro";
import TableOfContents from "@/components/content/TableOfContents";
import { getArticleOgImageUrl, getArticleTrail } from "@/utils/server/content";
import type { HeadingType } from "@/utils/types";
import StarLayout from "./StarLayout.astro";
import "./LogLayout.css";

interface Props {
  frontmatter: {
    title: string;
    description?: string;
    tags?: string[];
    releaseDate: Date | string;
    image?: string;
    lastModified?: string;
    minutesRead?: string;
  };
  headings?: HeadingType[];
}

const { frontmatter, headings = [] } = Astro.props;
const releaseDate = new Date(frontmatter.releaseDate);
const articleModifiedTime = frontmatter.lastModified
  ? new Date(frontmatter.lastModified).toISOString()
  : releaseDate.toISOString();
const slugFromPath = Astro.url.pathname
  .replace(/^\/dev-log\//, "")
  .replace(/\/$/, "");
const [year = "—", entryId = "—"] = slugFromPath.split("/");
const titleTransitionName = `devlog-title-${slugFromPath.replaceAll("/", "-") || "entry"}`;
const articleTrail = slugFromPath
  ? await getArticleTrail("log", slugFromPath)
  : { related: [] };
const ogImageUrl = getArticleOgImageUrl(Astro.url.pathname, Astro.site);
const publishedDateLabel = releaseDate.toLocaleDateString("en-US", {
  month: "long",
  day: "numeric",
  year: "numeric",
  timeZone: "UTC",
});
const updatedDateLabel = new Date(articleModifiedTime).toLocaleDateString(
  "en-US",
  {
    month: "long",
    day: "numeric",
    year: "numeric",
    timeZone: "UTC",
  },
);
---

<StarLayout
  description={frontmatter.description || ""}
  title={frontmatter.title}
  image={frontmatter.image}
  ogImageUrl={ogImageUrl}
  articlePublishedTime={releaseDate.toISOString()}
  articleModifiedTime={articleModifiedTime}
  articleAuthor="Maximilian Mauroner"
>
  <Fragment slot="head">
    <ArticleJsonLd
      title={frontmatter.title}
      description={frontmatter.description}
      tags={frontmatter.tags ?? []}
      publishedAt={releaseDate.toISOString()}
      modifiedAt={articleModifiedTime}
      sectionName="Dev Log"
      sectionPath="/dev-log/"
    />
  </Fragment>
  <ReadingProgress client:load />

  <div class="detail-patchbay-shell animate-fade-in">
    <header class="detail-patchbay">
      <span class="detail-patchbay__screw detail-patchbay__screw--tl"></span>
      <span class="detail-patchbay__screw detail-patchbay__screw--tr"></span>
      <span class="detail-patchbay__screw detail-patchbay__screw--bl"></span>
      <span class="detail-patchbay__screw detail-patchbay__screw--br"></span>

      <div class="detail-patchbay__frame">
        <div class="detail-patchbay__meta">
          <span>DEV / {year}.{entryId}</span>
          <time datetime={releaseDate.toISOString()}>{publishedDateLabel}</time>
        </div>

        <div
          class:list={[
            "detail-patchbay__hero-grid",
            { "detail-patchbay__hero-grid--text-only": !frontmatter.image },
          ]}
        >
          <div class="detail-patchbay__copy">
            <span class="detail-patchbay__kicker">
              <i aria-hidden="true"></i>
              Modular studio panel
            </span>

            {
              frontmatter.tags && frontmatter.tags.length > 0 && (
                <div class="detail-patchbay__sockets">
                  <FontmatterTagsList tags={frontmatter.tags} />
                </div>
              )
            }

            <h1 transition:name={titleTransitionName}>{frontmatter.title}</h1>

            {
              frontmatter.description && (
                <p class="detail-patchbay__description">
                  {frontmatter.description}
                </p>
              )
            }

            <dl class="detail-patchbay__facts">
              <div>
                <dt>Released</dt>
                <dd>{publishedDateLabel}</dd>
              </div>
              {
                frontmatter.minutesRead && (
                  <div>
                    <dt>Runtime</dt>
                    <dd>{frontmatter.minutesRead}</dd>
                  </div>
                )
              }
              <div>
                <dt>Serviced</dt>
                <dd>{updatedDateLabel}</dd>
              </div>
            </dl>
          </div>

          {
            frontmatter.image && (
              <figure class="detail-patchbay__visual">
                <PostImageLoader
                  imagePath={frontmatter.image}
                  altText={frontmatter.title}
                  className="h-full w-full object-cover"
                />
                <figcaption>Field attachment / channel {entryId}</figcaption>
              </figure>
            )
          }
        </div>
      </div>
    </header>

    <article class="detail-patchbay__article">
      <span class="detail-patchbay__screw detail-patchbay__screw--tl"></span>
      <span class="detail-patchbay__screw detail-patchbay__screw--tr"></span>
      <span class="detail-patchbay__screw detail-patchbay__screw--bl"></span>
      <span class="detail-patchbay__screw detail-patchbay__screw--br"></span>

      <header class="detail-patchbay__article-header">
        <span><i aria-hidden="true"></i> Article output</span>
        <span>CHANNEL {entryId.padStart(2, "0")}</span>
      </header>

      <div class="detail-patchbay__article-panel">
        <div class="detail-patchbay__prose prose prose-lg max-w-none dark:prose-invert">
          <slot />
        </div>
      </div>
    </article>

    {
      headings.length > 0 && (
        <TableOfContents headingsArr={headings} client:idle />
      )
    }
  </div>

  <RelatedPosts
    previous={articleTrail.previous}
    next={articleTrail.next}
    items={articleTrail.related}
  />
</StarLayout>
