---
import FontmatterTagsList from "@/components/content/FontmatterTagsList.astro";
import PostImageLoader from "@/components/content/PostImageLoader.astro";
import ReadingProgress from "@/components/content/ReadingProgress";
import RelatedPosts from "@/components/content/RelatedPosts.astro";
import TableOfContents from "@/components/content/TableOfContents";
import { getArticleOgImageUrl, getArticleTrail } from "@/utils/server/content";
import type { HeadingType } from "@/utils/types";
import StarLayout from "./StarLayout.astro";
import "./LogLayout.css";

interface Props {
  frontmatter: {
    title: string;
    description?: string;
    tags?: string[];
    releaseDate: Date | string;
    image?: string;
    lastModified?: string;
    minutesRead?: string;
  };
  headings?: HeadingType[];
}

const { frontmatter, headings = [] } = Astro.props;
const releaseDate = new Date(frontmatter.releaseDate);
const articleModifiedTime = frontmatter.lastModified
  ? new Date(frontmatter.lastModified).toISOString()
  : releaseDate.toISOString();
const slugFromPath = Astro.url.pathname
  .replace(/^\/dev-log\//, "")
  .replace(/\/$/, "");
const [year = "—", entryId = "—"] = slugFromPath.split("/");
const titleTransitionName = `devlog-title-${slugFromPath.replaceAll("/", "-") || "entry"}`;
const articleTrail = slugFromPath
  ? await getArticleTrail("log", slugFromPath)
  : { related: [] };
const ogImageUrl = getArticleOgImageUrl(Astro.url.pathname, Astro.site);
const publishedDateLabel = releaseDate.toLocaleDateString("en-US", {
  month: "long",
  day: "numeric",
  year: "numeric",
  timeZone: "UTC",
});
const updatedDateLabel = new Date(articleModifiedTime).toLocaleDateString(
  "en-US",
  {
    month: "long",
    day: "numeric",
    year: "numeric",
    timeZone: "UTC",
  },
);
---

<StarLayout
  description={frontmatter.description || ""}
  title={frontmatter.title}
  image={frontmatter.image}
  ogImageUrl={ogImageUrl}
  articlePublishedTime={releaseDate.toISOString()}
  articleModifiedTime={articleModifiedTime}
  articleAuthor="Maximilian Mauroner"
>
  <ReadingProgress family="log" client:load />
  <div class="log-editorial">
    <div class="log-shell log-reader">
      <a class="log-back" href="/dev-log/">← All entries</a>
      <header class="log-reading-head">
        <div class="log-meta">
          <time datetime={releaseDate.toISOString()}>{publishedDateLabel}</time>
          <span>{year} / {entryId}</span>
          {frontmatter.minutesRead && <span>{frontmatter.minutesRead}</span>}
        </div>
        <h1 transition:name={titleTransitionName}>{frontmatter.title}</h1>
        {frontmatter.tags && frontmatter.tags.length > 0 && <div class="log-reading-tags"><FontmatterTagsList tags={frontmatter.tags} /></div>}
        {articleModifiedTime !== releaseDate.toISOString() && <p class="log-updated">Updated <time datetime={articleModifiedTime}>{updatedDateLabel}</time></p>}
      </header>
      {frontmatter.image && <figure class="log-reading-image"><PostImageLoader imagePath={frontmatter.image} altText={frontmatter.title} /></figure>}
      <div class="log-reading-columns">
        {headings.length > 0 && <nav class="log-reading-outline" aria-label="In this entry"><h2>In this entry</h2>{headings.filter(heading => heading.depth === 2).map(heading => <a href={`#${heading.slug}`}>{heading.text}</a>)}</nav>}
        <article class="log-prose prose prose-lg max-w-none"><slot /></article>
      </div>
      {headings.length > 0 && <TableOfContents headingsArr={headings} family="log" client:idle />}
      <RelatedPosts family="log" previous={articleTrail.previous} next={articleTrail.next} items={articleTrail.related} />
    </div>
  </div>
</StarLayout>
