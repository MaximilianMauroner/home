---
import PostImageLoader from "@/components/content/PostImageLoader.astro";
import ReadingProgress from "@/components/content/ReadingProgress";
import RelatedPosts from "@/components/content/RelatedPosts.astro";
import TableOfContents from "@/components/content/TableOfContents";
import { getArticleOgImageUrl, getArticleTrail } from "@/utils/server/content";
import { type HeadingType } from "@/utils/types";
import StarLayout from "./StarLayout.astro";
import "./BlogLayout.css";

interface Props {
  frontmatter: {
    title: string;
    description?: string;
    tags?: string[];
    releaseDate: Date | string;
    image?: string;
    type?: string;
    lastModified?: string;
    minutesRead?: string;
  };
  headings?: HeadingType[];
}

const { frontmatter, headings = [] } = Astro.props;
const releaseDate = new Date(frontmatter.releaseDate);
const articleModifiedTime = frontmatter.lastModified
  ? new Date(frontmatter.lastModified).toISOString()
  : releaseDate.toISOString();
const publishedDateLabel = releaseDate.toLocaleDateString("en-US", {
  month: "short",
  day: "numeric",
  year: "numeric",
  timeZone: "UTC",
});
const updatedDateLabel = new Date(articleModifiedTime).toLocaleDateString(
  "en-US",
  {
    month: "short",
    day: "numeric",
    year: "numeric",
    timeZone: "UTC",
  },
);
const slugFromPath = Astro.url.pathname
  .replace(/^\/blog\//, "")
  .replace(/\/$/, "");
const sanitizedSlug = slugFromPath.replaceAll("/", "-");
const titleTransitionName = `blog-title-${sanitizedSlug || "blog"}`;
const articleTrail = slugFromPath
  ? await getArticleTrail("blog", slugFromPath)
  : { related: [] };
const ogImageUrl = getArticleOgImageUrl(Astro.url.pathname, Astro.site);
const tags = frontmatter.tags ?? [];
---

<StarLayout
  description={frontmatter.description || ""}
  title={frontmatter.title}
  image={frontmatter.image}
  ogImageUrl={ogImageUrl}
  articlePublishedTime={releaseDate.toISOString()}
  articleModifiedTime={articleModifiedTime}
  articleAuthor="Maximilian Mauroner"
>
  <ReadingProgress client:load />

  <main class="blog-detail-page animate-fade-in">
    <header class="blog-detail-map">
      {
        frontmatter.image && (
          <figure class="blog-detail-image" aria-hidden="true">
            <PostImageLoader
              imagePath={frontmatter.image}
              altText=""
              className="blog-detail-image-source"
            />
          </figure>
        )
      }

      <div class="blog-detail-contours" aria-hidden="true">
        <span></span><span></span><span></span><span></span><span></span>
        <i></i>
      </div>

      <div class="blog-detail-meta">
        <time datetime={releaseDate.toISOString()}>{publishedDateLabel}</time>
        <span>{frontmatter.type ?? "Essay"}</span>
      </div>

      <div class="blog-detail-intro">
        <h1 transition:name={titleTransitionName}>{frontmatter.title}</h1>
        {
          frontmatter.description && (
            <p>{frontmatter.description}</p>
          )
        }
      </div>

      <footer class="blog-detail-footer">
        {
          tags.length > 0 && (
            <ol aria-label="Topics">
              {tags.map((tag, index) => (
                <li>
                  <span>{String(index + 1).padStart(2, "0")}</span>
                  <a href={`/tags/${tag}/`}>{tag}</a>
                </li>
              ))}
            </ol>
          )
        }
        <div class="blog-detail-reading-meta" aria-label="Article details">
          {frontmatter.minutesRead && <span>{frontmatter.minutesRead}</span>}
          <span>Updated {updatedDateLabel}</span>
        </div>
      </footer>
    </header>

    <div class="blog-detail-body">
      <div class="blog-detail-body-label" aria-hidden="true">
        <span>Reading route</span>
        <span>Follow trail ↓</span>
      </div>
      <article class="blog-detail-prose prose prose-lg prose-slate dark:prose-invert">
        <slot />
      </article>
    </div>

    {
      headings.length > 0 && (
        <TableOfContents headingsArr={headings} client:idle />
      )
    }
  </main>

  <div class="blog-detail-related">
    <RelatedPosts
      previous={articleTrail.previous}
      next={articleTrail.next}
      items={articleTrail.related}
    />
  </div>
</StarLayout>
