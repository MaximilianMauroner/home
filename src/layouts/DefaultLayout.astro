---
import Header from "@/components/layout/Header.astro";
import Footer from "@/components/layout/Footer.astro";
import type { ImageMetadata } from "astro";
import { getImage } from "astro:assets";
import { serializeJsonLd } from "@/utils/server/seo";
interface Props {
  title: string;
  description: string;
  image?: string;
  articlePublishedTime?: string;
  articleModifiedTime?: string;
  articleAuthor?: string;
  ogImageUrl?: string;
  ogImageWidth?: number;
  ogImageHeight?: number;
  ogImageType?: string;
  noindex?: boolean;
}
const {
  title,
  description,
  image,
  articlePublishedTime,
  articleModifiedTime,
  articleAuthor,
  ogImageUrl,
  ogImageWidth = 1200,
  ogImageHeight = 630,
  ogImageType = "image/png",
  noindex = false,
} = Astro.props;
const documentTitle = title.includes("Maximilian Mauroner")
  ? title
  : `${title} | Maximilian Mauroner`;
import "@/styles/globals.css";
import Posthog from "@/components/layout/Posthog.astro";

// Normalize trailing slashes - ensure all URLs end with trailing slash (except root)
let normalizedPathname = Astro.url.pathname;
if (normalizedPathname !== "/" && !normalizedPathname.endsWith("/")) {
  normalizedPathname = normalizedPathname + "/";
}
const canonicalURL = new URL(normalizedPathname, Astro.site);
const isTagSearchVariant =
  normalizedPathname === "/tags/" && Astro.url.searchParams.has("q");

const shouldNoindex =
  noindex ||
  Astro.url.pathname.startsWith("/admin") ||
  Astro.url.pathname === "/404" ||
  isTagSearchVariant;
const robotsContent = shouldNoindex ? "noindex, follow" : "index, follow";
const analyticsExcludedPrefixes = [
  "/admin",
  "/tools/leaveify/",
  "/tools/readwise-tags-mapper/",
  "/tools/spotify-stats/",
  "/tools/whatsapp-stats/",
];
const shouldLoadAnalytics =
  import.meta.env.PROD &&
  !analyticsExcludedPrefixes.some((prefix) =>
    normalizedPathname.startsWith(prefix),
  );

const images = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/**/*.{jpeg,jpg,png,gif,webp,avif}"
);
let contentMetaImageUrl: string | undefined;
if (image && images[image]) {
  const img = await getImage({
    src: images[image](),
    width: 1024,
    height: 1024,
  });
  contentMetaImageUrl = new URL(img.src, Astro.site ?? Astro.url).href;
} else if (image) {
  const img = await getImage({
    src: "/astronaut.avif",
    width: 1024,
    height: 1024,
  });
  contentMetaImageUrl = new URL(img.src, Astro.site ?? Astro.url).href;
}
const firstPathSegment = Astro.url.pathname.split("/").filter(Boolean)[0];
const sectionOgSlug = ["blog", "dev-log", "snacks", "tags", "tools"].includes(
  firstPathSegment ?? "",
)
  ? firstPathSegment
  : "home";
const fallbackMetaImageUrl = new URL(
  `/og/section/${sectionOgSlug}.png`,
  Astro.site ?? Astro.url,
).href;
const metaImageUrl = ogImageUrl ?? contentMetaImageUrl ?? fallbackMetaImageUrl;
const ogType = articlePublishedTime ? "article" : "website";
const siteHostname = new URL(Astro.site ?? Astro.url.origin).hostname.replace(
  /^www\./,
  "",
);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Primary Meta Tags -->
    <title>{documentTitle}</title>
    <meta name="title" content={documentTitle} />
    <meta name="description" content={description} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={documentTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={metaImageUrl} />
    {
      ogImageUrl && (
        <>
          <meta property="og:image:width" content={String(ogImageWidth)} />
          <meta property="og:image:height" content={String(ogImageHeight)} />
          <meta property="og:image:type" content={ogImageType} />
        </>
      )
    }

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={documentTitle} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={metaImageUrl} />

    <!-- Article Meta Tags -->
    {
      articlePublishedTime && (
        <>
          <meta
            property="article:published_time"
            content={articlePublishedTime}
          />
          <meta name="article:published_time" content={articlePublishedTime} />
        </>
      )
    }
    {
      articleModifiedTime && (
        <>
          <meta
            property="article:modified_time"
            content={articleModifiedTime}
          />
          <meta name="article:modified_time" content={articleModifiedTime} />
        </>
      )
    }
    {
      articleAuthor && (
        <>
          <meta property="article:author" content={articleAuthor} />
          <meta name="article:author" content={articleAuthor} />
        </>
      )
    }

    <!-- Favicon -->
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.json" />

    <!-- RSS Feed -->
    <link rel="alternate" type="application/rss+xml" href="/rss.xml" />
    <meta name="generator" content={Astro.generator} />
    <!-- Robots meta tag -->
    <meta name="robots" content={robotsContent} />
    {shouldLoadAnalytics && <Posthog />}
    <slot name="head" />

    <!-- Website Schema for Sitelinks Optimization -->
    {
      Astro.url.pathname === "/" && (
        <script
          is:inline
          type="application/ld+json"
          set:html={serializeJsonLd({
            "@context": "https://schema.org",
            "@type": "WebSite",
            name: "Maximilian Mauroner",
            url: Astro.site,
            description:
              "Just a dev sharing cool stuff: code snippets that work, dev stories that might help, and random tech tools I think are neat.",
            publisher: {
              "@type": "Person",
              name: "Maximilian Mauroner",
              url: Astro.site,
            },
            mainEntity: {
              "@type": "ItemList",
              itemListElement: [
                {
                  "@type": "ListItem",
                  position: 1,
                  name: "Dev Log",
                  url: new URL("/dev-log/", Astro.site).href,
                  description: "Development logs and updates",
                },
                {
                  "@type": "ListItem",
                  position: 2,
                  name: "Blog",
                  url: new URL("/blog/", Astro.site).href,
                  description: "Blog posts about development and technology",
                },
                {
                  "@type": "ListItem",
                  position: 3,
                  name: "Snacks",
                  url: new URL("/snacks/", Astro.site).href,
                  description: "Quick tips and code snippets",
                },
                {
                  "@type": "ListItem",
                  position: 4,
                  name: "Tools",
                  url: new URL("/tools/", Astro.site).href,
                  description: "Interactive tools and utilities",
                },
                {
                  "@type": "ListItem",
                  position: 5,
                  name: "Tags",
                  url: new URL("/tags/", Astro.site).href,
                  description: "Browse content by tags",
                },
              ],
            },
          })}
        />
      )
    }

    <script is:inline>
      const setColorTheme = (darkMode, isInteraction = true) => {
        if (isInteraction) {
          document.documentElement.classList.add("theme-changing");
        }
        document.documentElement.classList.toggle("dark", darkMode);
        localStorage.setItem("theme", darkMode ? "dark" : "light");
        if (isInteraction) {
          requestAnimationFrame(() => {
            document.documentElement.classList.remove("theme-changing");
          });
        }
      };
      window.setColorTheme = setColorTheme;
      const storedTheme = localStorage.getItem("theme");

      if (storedTheme) {
        setColorTheme(storedTheme === "dark", false);
      } else {
        const systemDark = window.matchMedia(
          "(prefers-color-scheme: dark)"
        ).matches;
        setColorTheme(systemDark, false);
      }
      document.addEventListener("astro:after-swap", () => {
        const storedTheme = localStorage.getItem("theme");
        if (storedTheme) {
          setColorTheme(storedTheme === "dark", false);
        }
      });
    </script>
  </head>
  <body lang="en" class="flex min-h-dvh flex-col">
    <a
      href="#main-content"
      class="sr-only z-[100] rounded-md bg-background px-4 py-3 text-foreground shadow-lg focus:not-sr-only focus:fixed focus:left-4 focus:top-4"
    >
      Skip to main content
    </a>
    <Header />
    <main id="main-content" tabindex="-1" class="min-w-0 flex-1">
      <slot />
    </main>
    <Footer />
    <script is:inline define:vars={{ siteHostname }}>
      const setLinkTarget = (link, originalTarget, originalRel) => {
        const url = new URL(link.href);
        const isExternal =
          (url.protocol === "http:" || url.protocol === "https:") &&
          url.hostname !== siteHostname &&
          url.hostname !== `www.${siteHostname}` &&
          url.origin !== window.location.origin;

        if (isExternal) {
          link.target = "_blank";
          link.relList.add("noopener", "noreferrer");
        } else {
          link.removeAttribute("target");
        }

        setTimeout(() => {
          if (originalTarget === null) link.removeAttribute("target");
          else link.setAttribute("target", originalTarget);

          if (originalRel === null) link.removeAttribute("rel");
          else link.setAttribute("rel", originalRel);
        });
      };

      window.linkTargetController?.abort();
      window.linkTargetController = new AbortController();
      document.addEventListener(
        "click",
        (event) => {
          if (!(event.target instanceof Element)) return;
          const link = event.target.closest("a[href]");
          if (!link) return;

          const originalTarget = link.getAttribute("target");
          const originalRel = link.getAttribute("rel");
          setLinkTarget(link, originalTarget, originalRel);
        },
        { capture: true, signal: window.linkTargetController.signal }
      );
    </script>
  </body>
</html>
