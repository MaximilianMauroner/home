---
import Header from "@/components/layout/Header.astro";
import Footer from "@/components/layout/Footer.astro";
import type { ImageMetadata } from "astro";
import { getImage } from "astro:assets";
interface Props {
  title: string;
  description: string;
  image?: string;
  articlePublishedTime?: string;
  articleModifiedTime?: string;
  articleAuthor?: string;
  ogImageUrl?: string;
  ogImageWidth?: number;
  ogImageHeight?: number;
  ogImageType?: string;
  noindex?: boolean;
}
const {
  title,
  description,
  image,
  articlePublishedTime,
  articleModifiedTime,
  articleAuthor,
  ogImageUrl,
  ogImageWidth = 1200,
  ogImageHeight = 630,
  ogImageType = "image/png",
  noindex = false,
} = Astro.props;
import "@/styles/globals.css";
import Posthog from "@/components/layout/Posthog.astro";

// Normalize trailing slashes - ensure all URLs end with trailing slash (except root)
let normalizedPathname = Astro.url.pathname;
if (normalizedPathname !== "/" && !normalizedPathname.endsWith("/")) {
  normalizedPathname = normalizedPathname + "/";
}
const canonicalURL = new URL(normalizedPathname, Astro.site);
// Preserve query parameters for search pages (tags page with q parameter)
if (Astro.url.pathname === "/tags/" && Astro.url.searchParams.has("q")) {
  canonicalURL.search = Astro.url.search;
}

const shouldNoindex =
  noindex ||
  Astro.url.pathname.startsWith("/admin") ||
  Astro.url.pathname === "/404";

const images = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/**/*.{jpeg,jpg,png,gif,webp,avif}"
);
let img;
if (image && images[image]) {
  img = await getImage({
    src: images[image](),
    width: 1024,
    height: 1024,
  });
} else {
  img = await getImage({
    src: "/astronaut.avif",
    width: 1024,
    height: 1024,
  });
}
const metaImageUrl = ogImageUrl ?? new URL(img.src, Astro.site ?? Astro.url).href;
const ogType = articlePublishedTime ? "article" : "website";
const siteHostname = new URL(Astro.site ?? Astro.url.origin).hostname.replace(
  /^www\./,
  "",
);
---

<html lang="en">
  <>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={metaImageUrl} />
    {
      ogImageUrl && (
        <>
          <meta property="og:image:width" content={String(ogImageWidth)} />
          <meta property="og:image:height" content={String(ogImageHeight)} />
          <meta property="og:image:type" content={ogImageType} />
        </>
      )
    }

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={metaImageUrl} />

    <!-- Article Meta Tags -->
    {
      articlePublishedTime && (
        <>
          <meta
            property="article:published_time"
            content={articlePublishedTime}
          />
          <meta name="article:published_time" content={articlePublishedTime} />
        </>
      )
    }
    {
      articleModifiedTime && (
        <>
          <meta
            property="article:modified_time"
            content={articleModifiedTime}
          />
          <meta name="article:modified_time" content={articleModifiedTime} />
        </>
      )
    }
    {
      articleAuthor && (
        <>
          <meta property="article:author" content={articleAuthor} />
          <meta name="article:author" content={articleAuthor} />
        </>
      )
    }

    <!-- Favicon -->
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.json" />

    <!-- RSS Feed -->
    <link rel="alternate" type="application/rss+xml" href="/rss.xml" />
    <meta name="generator" content={Astro.generator} />
    <!-- Robots meta tag -->
    {
      shouldNoindex ? (
        <meta name="robots" content="noindex, nofollow" />
      ) : (
        <meta name="robots" content="index, follow" />
      )
    }
    {import.meta.env.PROD && <Posthog />}

    <!-- Website Schema for Sitelinks Optimization -->
    {
      Astro.url.pathname === "/" && (
        <script
          is:inline
          type="application/ld+json"
          set:html={JSON.stringify({
            "@context": "https://schema.org",
            "@type": "WebSite",
            name: "Maximilian Mauroner",
            url: Astro.site,
            description:
              "Software developer studying at TU Wien, sharing open-source tools, engineering notes, experiments, and practical articles.",
            publisher: {
              "@type": "Person",
              name: "Maximilian Mauroner",
              url: Astro.site,
            },
            potentialAction: {
              "@type": "SearchAction",
              target: {
                "@type": "EntryPoint",
                urlTemplate: `${new URL("/tags/", Astro.site).href}?q={search_term_string}`,
              },
              "query-input": "required name=search_term_string",
            },
            mainEntity: {
              "@type": "ItemList",
              itemListElement: [
                {
                  "@type": "ListItem",
                  position: 1,
                  name: "Dev Log",
                  url: new URL("/dev-log/", Astro.site).href,
                  description: "Development logs and updates",
                },
                {
                  "@type": "ListItem",
                  position: 2,
                  name: "Blog",
                  url: new URL("/blog/", Astro.site).href,
                  description: "Blog posts about development and technology",
                },
                {
                  "@type": "ListItem",
                  position: 3,
                  name: "Snacks",
                  url: new URL("/snacks/", Astro.site).href,
                  description: "Quick tips and code snippets",
                },
                {
                  "@type": "ListItem",
                  position: 4,
                  name: "Tools",
                  url: new URL("/tools/", Astro.site).href,
                  description: "Interactive tools and utilities",
                },
                {
                  "@type": "ListItem",
                  position: 5,
                  name: "Tags",
                  url: new URL("/tags/", Astro.site).href,
                  description: "Browse content by tags",
                },
              ],
            },
          })}
        />
      )
    }

    <script is:inline>
      const setColorTheme = (darkMode, isInteraction = true) => {
        if (isInteraction) {
          document.documentElement.classList.add("theme-changing");
        }
        document.documentElement.classList.toggle("dark", darkMode);
        localStorage.setItem("theme", darkMode ? "dark" : "light");
        if (isInteraction) {
          requestAnimationFrame(() => {
            document.documentElement.classList.remove("theme-changing");
          });
        }
      };
      window.setColorTheme = setColorTheme;
      const storedTheme = localStorage.getItem("theme");

      if (storedTheme) {
        setColorTheme(storedTheme === "dark", false);
      } else {
        const systemDark = window.matchMedia(
          "(prefers-color-scheme: dark)"
        ).matches;
        setColorTheme(systemDark, false);
      }
      document.addEventListener("astro:after-swap", () => {
        const storedTheme = localStorage.getItem("theme");
        if (storedTheme) {
          setColorTheme(storedTheme === "dark", false);
        }
      });
    </script>
  </>
  <body lang="en" class="flex min-h-dvh flex-col">
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <Header />
    <main id="main-content" class="min-w-0 flex-1" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <script is:inline define:vars={{ siteHostname }}>
      const setLinkTarget = (link, originalTarget, originalRel) => {
        const url = new URL(link.href);
        const isExternal =
          (url.protocol === "http:" || url.protocol === "https:") &&
          url.hostname !== siteHostname &&
          url.hostname !== `www.${siteHostname}` &&
          url.origin !== window.location.origin;

        if (isExternal) {
          link.target = "_blank";
          link.relList.add("noopener", "noreferrer");
        } else {
          link.removeAttribute("target");
        }

        setTimeout(() => {
          if (originalTarget === null) link.removeAttribute("target");
          else link.setAttribute("target", originalTarget);

          if (originalRel === null) link.removeAttribute("rel");
          else link.setAttribute("rel", originalRel);
        });
      };

      window.linkTargetController?.abort();
      window.linkTargetController = new AbortController();
      document.addEventListener(
        "click",
        (event) => {
          if (!(event.target instanceof Element)) return;
          const link = event.target.closest("a[href]");
          if (!link) return;

          const originalTarget = link.getAttribute("target");
          const originalRel = link.getAttribute("rel");
          setLinkTarget(link, originalTarget, originalRel);
        },
        { capture: true, signal: window.linkTargetController.signal }
      );
    </script>
  </body>
</html>

<style>
  .skip-link {
    position: fixed;
    top: 0.75rem;
    left: 0.75rem;
    z-index: 100;
    padding: 0.65rem 0.9rem;
    border-radius: var(--radius-md);
    background: var(--foreground);
    color: var(--background);
    font-weight: 700;
    text-decoration: none;
    transform: translateY(calc(-100% - 1rem));
    transition: transform 150ms ease;
  }

  .skip-link:focus-visible {
    outline: 2px solid var(--ring);
    outline-offset: 3px;
    transform: translateY(0);
  }
</style>
