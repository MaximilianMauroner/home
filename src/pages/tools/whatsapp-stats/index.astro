---
export const title = "WhatsApp Stats";
export const description = "A tool to visualize your WhatsApp chat habits";
import WhatsappIndex from "@/components/tools/WhatsAppStats/Index";
import ToolPage from "@/components/tools/ToolPage.astro";
import { getToolThemeClass } from "@/components/tools/toolTheme";
import StarLayout from "@/layouts/StarLayout.astro";
---

<StarLayout title={title} description={description}>
  <ToolPage
    theme={getToolThemeClass("whatsapp-stats")}
    title="WhatsApp Stats"
    description="Upload your WhatsApp chat export to analyze your messaging patterns"
  >
    <div slot="header-extra" class="rounded-lg border border-border bg-card p-3">
      <p class="text-xs leading-5 text-muted-foreground">
        Chat data is processed locally in your browser, saved in this device's
        browser storage, and never uploaded to a server.
      </p>
    </div>
    <WhatsappIndex client:load />
  </ToolPage>
</StarLayout>
