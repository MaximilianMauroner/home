---
export const title = "Colour Contrast Trainer";
export const description =
  "Train your eye to spot subtle opacity differences. Each streak tightens the alpha contrast or expands the grid.";

import ColourGame from "@/components/tools/ColourGame";
import ToolPage from "@/components/tools/ToolPage.astro";
import { getToolThemeClass } from "@/components/tools/toolTheme";
import StarLayout from "@/layouts/StarLayout.astro";
---

<StarLayout title={title} description={description}>
  <ToolPage
    theme={getToolThemeClass("colour-game")}
    title={title}
    description={description}
  >
    <ColourGame client:only="react" />
  </ToolPage>
</StarLayout>
