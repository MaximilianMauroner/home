---
export const title = "Photo Journey";
export const description = "Play your photos as a journey, with animated maps, offline place names, and route exports.";

import PhotoJourney from "@/components/tools/PhotoJourney/PhotoJourney";
import ToolPage from "@/components/tools/ToolPage.astro";
import { getToolThemeClass } from "@/components/tools/toolTheme";
import StarLayout from "@/layouts/StarLayout.astro";
---

<StarLayout title={title} description={description}>
  <ToolPage wide theme={getToolThemeClass("photo-journey")} title={title} description={description}>
    <div slot="header-extra" class="rounded-lg border border-border bg-card p-3">
      <p class="text-xs leading-5 text-muted-foreground">Photo and GPX files stay in this browser tab. Best-photo analysis downloads a face model but does not upload your images. The offline grid sends no map requests. The OpenStreetMap and Terrain modes fetch map and elevation tiles, which reveal the areas shown to the tile providers.</p>
    </div>
    <PhotoJourney client:only="react">
      <div slot="fallback" class="photo-journey-loading" role="status" aria-live="polite">
        <span class="photo-journey-loading-spinner" aria-hidden="true"></span>
        <strong>Loading Photo Journey…</strong>
      </div>
    </PhotoJourney>
  </ToolPage>
</StarLayout>

<style>
  .photo-journey-loading {
    display: grid;
    min-height: 20rem;
    place-content: center;
    justify-items: center;
    gap: 0.9rem;
    border: 1px dashed var(--border);
    border-radius: 1rem;
    background: var(--card);
    color: var(--foreground);
  }

  .photo-journey-loading-spinner {
    width: 2rem;
    height: 2rem;
    border: 3px solid color-mix(in oklch, var(--tool-accent) 24%, transparent);
    border-top-color: var(--tool-accent);
    border-radius: 50%;
    animation: photo-journey-loading-spin 0.8s linear infinite;
  }

  @keyframes photo-journey-loading-spin {
    to { transform: rotate(1turn); }
  }

  @media (prefers-reduced-motion: reduce) {
    .photo-journey-loading-spinner { animation-duration: 1.8s; }
  }
</style>
