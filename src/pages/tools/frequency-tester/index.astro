---
export const title = "Frequency tester";
export const description =
  "Generate pristine stereo tones, adjust channels independently, and explore binaural beats with a refined interface.";

import FrequencyTester from "@/components/tools/FrequencyTester";
import ToolPage from "@/components/tools/ToolPage.astro";
import { getToolThemeClass } from "@/components/tools/toolTheme";
import StarLayout from "@/layouts/StarLayout.astro";
---

<StarLayout title={title} description={description}>
  <ToolPage theme={getToolThemeClass("frequency-tester")}>
    <FrequencyTester client:load />
  </ToolPage>
</StarLayout>
