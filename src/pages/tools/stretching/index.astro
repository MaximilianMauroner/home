---
export const title = "Stretching";
export const description = "A guided stretching routine with timer and auto-advance";
import Stretching from "@/components/tools/Stretching/Stretching";
import ToolPage from "@/components/tools/ToolPage.astro";
import { getToolThemeClass } from "@/components/tools/toolTheme";
import StarLayout from "@/layouts/StarLayout.astro";
---

<StarLayout title={title} description={description}>
  <ToolPage
    theme={getToolThemeClass("stretching")}
    title="Stretching Routine"
    description="A guided stretching routine with auto-advance timer. Customize your stretches and track your progress."
    wide
  >
    <Stretching client:load />
  </ToolPage>
</StarLayout>
