---
import "@/components/tools/toolStyles.css";
import StarLayout from "@/layouts/StarLayout.astro";
import { serializeJsonLd } from "@/utils/server/seo";
import {
  requireToolMetadata,
  isToolActive,
} from "@/components/tools/toolCatalog";
import { getToolThemeClass } from "@/components/tools/toolTheme";

const tools = import.meta.glob("./*/*.astro");
const toolPages = [];

for (const path in tools) {
  const tool = (await tools[path]()) as {
    title: string;
    description: string;
    active?: boolean;
  };
  const url = path.replace("src/pages", "").replace("/index.astro", "");
  const slug = url.split("/").filter(Boolean).pop() ?? "";
  if (tool.active === false || !isToolActive(slug)) continue;
  const metadata = requireToolMetadata(slug);
  const chips = Array.from(
    new Set(
      [
        metadata.category,
        metadata.privacy === "account"
          ? "account required"
          : metadata.privacy === "local"
            ? "local"
            : metadata.privacy,
        metadata.access !== "local" ? metadata.access : undefined,
        ...metadata.labels,
      ].filter((label): label is string => Boolean(label)),
    ),
  );
  toolPages.push({
    title: tool.title,
    description: tool.description,
    url: `/tools/${slug}/`,
    slug,
    ...metadata,
    chips,
  });
}

toolPages.sort((first, second) => {
  if (second.featured !== first.featured) {
    return second.featured - first.featured;
  }
  return first.title.localeCompare(second.title);
});

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Home",
      item: Astro.site,
    },
    {
      "@type": "ListItem",
      position: 2,
      name: "Tools",
      item: new URL("/tools/", Astro.site).href,
    },
  ],
};

const toolCount = toolPages.length;
const categories = Array.from(new Set(toolPages.map((tool) => tool.category)));
---

<StarLayout
  title="Tools"
  description="A collection of useful tools and utilities I've built"
>
  <script
    slot="head"
    is:inline
    type="application/ld+json"
    set:html={serializeJsonLd(breadcrumbSchema)}
  />
  <section class="tools-shell">
    <div class="tool-page-header">
      <div class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
        <div class="space-y-2">
          <h1 class="tool-page-title">Tools</h1>
          <p class="tool-page-description">
            Small utilities and experiments built for repeat use.
          </p>
        </div>
        <p class="text-sm font-medium text-muted-foreground">
          {toolCount} tool{toolCount === 1 ? "" : "s"}
        </p>
      </div>
      <div class="mt-4 flex flex-wrap gap-2">
        {
          categories.map((category) => (
            <span class="rounded-full border border-border/70 px-3 py-1 font-mono text-xs uppercase tracking-wider text-muted-foreground">
              {category}
            </span>
          ))
        }
      </div>
    </div>

    <div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-3">
      {
        toolPages.map((tool) => (
          <a
            href={tool.url}
            class={`tool-card tool-theme group ${getToolThemeClass(tool.slug)}`}
          >
            <div class="space-y-3">
              <div class="flex items-start justify-between gap-4">
                <div class="flex min-w-0 items-center gap-3">
                  <span class="tool-accent-mark" aria-hidden="true" />
                  <h2 class="text-lg font-semibold leading-tight text-foreground">
                    {tool.title}
                  </h2>
                </div>
                {tool.status !== "stable" && (
                  <span class="shrink-0 rounded-full bg-muted px-2 py-0.5 font-mono text-[0.65rem] uppercase tracking-wider text-muted-foreground">
                    {tool.status}
                  </span>
                )}
              </div>
              <div class="flex flex-wrap gap-2">
                {tool.chips.map((label: string) => (
                  <span class="tool-catalog-pill">{label}</span>
                ))}
              </div>
              <p class="line-clamp-3 text-sm leading-6 text-muted-foreground">
                {tool.description}
              </p>
            </div>
            <div class="tool-accent-text mt-6 text-sm font-medium">
              Open tool <span aria-hidden="true">→</span>
            </div>
          </a>
        ))
      }
    </div>
  </section>
</StarLayout>
