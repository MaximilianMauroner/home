---
import StarLayout from "@/layouts/StarLayout.astro";
import DirectoryArt from "@/components/tools/DirectoryArt.astro";
import "@/components/tools/directory.css";
import { serializeJsonLd } from "@/utils/server/seo";
import {
  requireToolMetadata,
  isToolActive,
} from "@/components/tools/toolCatalog";

const groups = [
  {
    id: "music",
    title: "Music & sound",
    description: "Playlists, listening habits, and audio checks.",
    categories: ["music", "audio"],
  },
  {
    id: "visual",
    title: "Photos & design",
    description: "Photo routes and colour perception.",
    categories: ["photo", "design"],
  },
  {
    id: "data",
    title: "Data & reading",
    description: "Chat habits and a tidier reading library.",
    categories: ["data", "reading"],
  },
  {
    id: "movement",
    title: "Movement",
    description: "Running calculations and stretching routines.",
    categories: ["fitness"],
  },
  {
    id: "ai",
    title: "AI experiments",
    description: "Explore opinions and the effects of AI on work.",
    categories: ["reflection", "simulation"],
  },
];

const routes = import.meta.glob<{
  title: string;
  description: string;
  active?: boolean;
}>("./*/*.astro");
const toolPages = [];
const accountLabels: Record<string, string> = {
  leaveify: "Spotify + TIDAL accounts",
  "readwise-tags-mapper": "Readwise token",
  "spotify-stats": "Spotify account · export file",
};

for (const [path, load] of Object.entries(routes)) {
  const tool = await load();
  const slug = path.split("/")[1];
  if (tool.active === false || !isToolActive(slug)) continue;
  const metadata = requireToolMetadata(slug);
  const group = groups.find((group) =>
    group.categories.includes(metadata.category),
  );
  if (!group) {
    throw new Error(`Missing directory group for "${slug}".`);
  }
  const access =
    metadata.privacy === "account"
      ? (accountLabels[slug] ?? metadata.access)
      : metadata.labels.includes("microphone permission")
        ? "Microphone permission · no account"
        : metadata.access.includes("file")
          ? "Local files · no account"
          : "No account needed";
  toolPages.push({
    ...tool,
    ...metadata,
    slug,
    url: `/tools/${slug}/`,
    access,
    search: [
      tool.title,
      tool.description,
      group.title,
      metadata.category,
      ...metadata.tags,
      ...metadata.labels,
    ]
      .join(" ")
      .toLocaleLowerCase(),
  });
}

const sortedTools = toolPages.toSorted(
  (first, second) =>
    second.featured - first.featured || first.title.localeCompare(second.title),
);
const sections = groups.map((group) => ({
  ...group,
  tools: sortedTools.filter((tool) => group.categories.includes(tool.category)),
}));
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: Astro.site },
    {
      "@type": "ListItem",
      position: 2,
      name: "Tools",
      item: new URL("/tools/", Astro.site).href,
    },
  ],
};
---

<StarLayout title="Tools" description="Tools I've built for music, photos, personal data, movement, and AI experiments.">
  <script slot="head" is:inline type="application/ld+json" set:html={serializeJsonLd(breadcrumbSchema)} />
  <div class="tool-directory" data-tool-directory>
    <header class="directory-heading">
      <div>
        <h1>Tools<span class="directory-title-mark" aria-hidden="true">.</span></h1>
        <p>Small utilities and experiments built for repeat use.</p>
      </div>
      <div class="directory-search" data-search-controls hidden>
        <label for="tool-search">Find a tool</label>
        <div class="directory-search-field">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5" /><path d="m15.5 15.5 5 5" /></svg>
          <input id="tool-search" type="search" placeholder="Photos, Spotify, running…" autocomplete="off" aria-controls="directory-groups" />
        </div>
        <label class="directory-account-filter"><input type="checkbox" data-no-account /> No account needed</label>
      </div>
    </header>

    <div class="directory-browse">
      <nav aria-label="Tool categories">
        {sections.map((group) => (
          <a href={`#${group.id}`} class={`directory-category-link directory-${group.id}`} data-category-link={group.id}>
            <span class="directory-dot" aria-hidden="true" />
            <span>{group.title}</span>
            <span class="directory-nav-count" data-nav-count>{group.tools.length}</span>
          </a>
        ))}
      </nav>
      <p class="directory-result-count" role="status" aria-live="polite" aria-atomic="true" data-result-count>{toolPages.length} tools</p>
    </div>

    <div id="directory-groups" class="directory-groups">
      {sections.map((group) => (
        <section id={group.id} class={`directory-group directory-${group.id}`} aria-labelledby={`${group.id}-title`} data-directory-group={group.id}>
          <header class="directory-group-heading">
            <div>
              <h2 id={`${group.id}-title`}>{group.title}</h2>
              <p>{group.description}</p>
            </div>
            <DirectoryArt group={group.id} />
          </header>
          <ul class="directory-tool-list">
            {group.tools.map((tool) => (
              <li data-tool data-search={tool.search} data-privacy={tool.privacy}>
                <a href={tool.url} class="directory-tool">
                  <div class="directory-tool-title">
                    <h3>{tool.title}</h3>
                    <svg class="directory-open-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6" /></svg>
                  </div>
                  <p class="directory-tool-description">{tool.description}</p>
                  {tool.slug === "colour-game" && (
                    <div class="directory-tool-sample" aria-hidden="true">
                      <span class="directory-contrast-board">{Array.from({ length: 9 }, () => <span />)}</span>
                      <span>Spot the lighter square</span>
                    </div>
                  )}
                  <div class="directory-tool-details">
                    <span>{tool.access}</span>
                    {tool.status !== "stable" && <span class="directory-tool-status">{tool.status}</span>}
                  </div>
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>
    <div class="directory-empty" data-empty hidden>
      <h2>No tools match these filters.</h2>
      <p>Try a different search or include tools that need an account.</p>
      <button type="button" data-reset>Show all tools</button>
    </div>
    <div class="directory-note">
      <button type="button" data-reset data-clear hidden>Clear filters</button>
    </div>
  </div>
</StarLayout>

<script>
  const directory = document.querySelector<HTMLElement>("[data-tool-directory]");
  if (directory) {
    const search = directory.querySelector<HTMLInputElement>("#tool-search")!;
    const noAccount =
      directory.querySelector<HTMLInputElement>("[data-no-account]")!;
    const sections = [
      ...directory.querySelectorAll<HTMLElement>("[data-directory-group]"),
    ];
    const count = directory.querySelector<HTMLElement>("[data-result-count]")!;
    const empty = directory.querySelector<HTMLElement>("[data-empty]")!;
    const clear = directory.querySelector<HTMLElement>("[data-clear]")!;
    const categoryLinks = [
      ...directory.querySelectorAll<HTMLAnchorElement>("[data-category-link]"),
    ];

    function filterTools() {
      const terms = search.value
        .trim()
        .toLocaleLowerCase()
        .split(/\s+/)
        .filter(Boolean);
      let visibleCount = 0;
      for (const section of sections) {
        let groupCount = 0;
        for (const tool of section.querySelectorAll<HTMLElement>("[data-tool]")) {
          const matches =
            terms.every((term) => tool.dataset.search?.includes(term)) &&
            (!noAccount.checked || tool.dataset.privacy === "local");
          tool.hidden = !matches;
          if (matches) groupCount++;
        }
        section.hidden = groupCount === 0;
        visibleCount += groupCount;
        const link = categoryLinks.find(
          (link) => link.dataset.categoryLink === section.dataset.directoryGroup,
        )!;
        link.hidden = groupCount === 0;
        link.querySelector("[data-nav-count]")!.textContent = String(groupCount);
      }
      count.textContent = `${visibleCount} tool${visibleCount === 1 ? "" : "s"}`;
      empty.hidden = visibleCount !== 0;
      clear.hidden = terms.length === 0 && !noAccount.checked;
      directory!.dataset.filtered = String(!clear.hidden);
    }

    search.addEventListener("input", filterTools);
    noAccount.addEventListener("change", filterTools);
    directory.querySelectorAll("[data-reset]").forEach((button) => {
      button.addEventListener("click", () => {
        search.value = "";
        noAccount.checked = false;
        filterTools();
        search.focus();
      });
    });
    directory.querySelector<HTMLElement>("[data-search-controls]")!.hidden =
      false;
    // The browser can restore inputs after Back navigation.
    window.addEventListener("pageshow", filterTools);
    filterTools();
  }
</script>
