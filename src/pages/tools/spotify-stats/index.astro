---
export const title = "Spotify Stats";
export const description = "A tool to visualize your Spotify listening habits";
import SpotifyStats from "@/components/tools/SpotifyStats";
import ToolPage from "@/components/tools/ToolPage.astro";
import { getToolThemeClass } from "@/components/tools/toolTheme";
import StarLayout from "@/layouts/StarLayout.astro";
---

<StarLayout title={title} description={description}>
  <ToolPage
    theme={getToolThemeClass("spotify-stats")}
    title="Spotify Stats"
    description="Upload your Spotify data to see your listening statistics"
  >
    <a
      slot="header-extra"
      href="https://support.stats.fm/docs/import/spotify-import/"
      target="_blank"
      rel="noopener noreferrer"
      class="text-sm text-primary hover:underline"
    >
      How to get your Spotify data →
    </a>
    <SpotifyStats client:load />
  </ToolPage>
</StarLayout>
