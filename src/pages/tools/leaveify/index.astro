---
export const title = "Leaveify";
export const description =
  "Move Spotify playlists and Liked Songs to TIDAL with OAuth login and track matching.";

import Leaveify from "@/components/tools/Leaveify/Leaveify";
import ToolPage from "@/components/tools/ToolPage.astro";
import { getToolThemeClass } from "@/components/tools/toolTheme";
import StarLayout from "@/layouts/StarLayout.astro";
---

<StarLayout title={title} description={description}>
  <ToolPage
    theme={getToolThemeClass("leaveify")}
    title="Leaveify"
    description="Move Spotify playlists and Liked Songs to TIDAL."
    wide
  >
    <Leaveify client:load />
  </ToolPage>
</StarLayout>
