---
export const title = "Pace calculator";
export const description =
  "Convert between kilometres and miles per hour, calculate splits, and estimate race finish times instantly.";

import PaceCalculator from "@/components/tools/PaceCalculator";
import ToolPage from "@/components/tools/ToolPage.astro";
import { getToolThemeClass } from "@/components/tools/toolTheme";
import StarLayout from "@/layouts/StarLayout.astro";
---

<StarLayout title={title} description={description}>
  <ToolPage
    theme={getToolThemeClass("pace-calculator")}
    title={title}
    description={description}
  >
    <PaceCalculator client:only="react" />
  </ToolPage>
</StarLayout>
