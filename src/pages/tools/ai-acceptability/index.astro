---
export const title = "AI acceptability test";
export const description =
  "Decide where AI is acceptable, then see whether your answers form a spectrum or a two-axis stance.";

import AIAcceptability from "@/components/tools/AIAcceptability/AIAcceptability";
import ToolPage from "@/components/tools/ToolPage.astro";
import { getToolThemeClass } from "@/components/tools/toolTheme";
import StarLayout from "@/layouts/StarLayout.astro";
---

<StarLayout title={title} description={description}>
  <ToolPage theme={getToolThemeClass("ai-acceptability")} wide>
    <AIAcceptability client:load />
  </ToolPage>
</StarLayout>
