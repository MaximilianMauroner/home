---
import TagView from "@/components/content/TagView";
import StarLayout from "@/layouts/StarLayout.astro";
import { getBlogs, getLogs, getSnacks, getTags } from "@/utils/server/content";

interface Props {
  tag: string;
}

const { tag } = Astro.params;

const blogs = await getBlogs();
const logs = await getLogs();
const snacks = await getSnacks();

const tags = getTags(blogs, logs, snacks);
const tagCount = tag ? (tags.get(tag) ?? 0) : 0;

export async function getStaticPaths() {
  const blogs = await getBlogs();
  const logs = await getLogs();
  const snacks = await getSnacks();
  const tags = getTags(blogs, logs, snacks);
  const allTagNames = tags.keys();
  return [...allTagNames].map((tag) => ({ params: { tag } }));
}
---

<StarLayout
  title={`Posts tagged “${tag}”`}
  description={`Browse blog posts, dev logs, and snacks about ${tag}.`}
  noindex={tagCount < 3}
>
  <div class="mx-auto max-w-screen-xl px-4 pt-8 lg:px-6 lg:pt-16">
    <header class="site-page-header lg:mb-8">
      <h1 class="site-page-title">Posts tagged “{tag}”</h1>
      <p class="site-page-description">
        Browse blog posts, dev logs, and snacks about {tag}.
      </p>
    </header>
  </div>
  <TagView
    tags={tags}
    blogs={blogs}
    logs={logs}
    snacks={snacks}
    preSelectedTag={tag}
    client:load
  />
</StarLayout>
