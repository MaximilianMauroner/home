---
import ImgAstronaut from "/public/astronaut.avif";
import { Picture } from "astro:assets";
import StarLayout from "@/layouts/StarLayout.astro";

Astro.response.status = 404;
---

<StarLayout
  title="404 - Page Not Found"
  description="The page you're looking for doesn't exist"
  noindex
>
  <div
    class="my-auto flex flex-col items-center justify-center bg-background px-4 py-8 sm:px-6 sm:py-12 lg:px-8"
  >
    <div class="mx-auto max-w-md text-center">
      <div
        class="mx-auto h-32 w-32 sm:h-48 sm:w-48"
        data-404-illustration
      >
        <Picture
          src={ImgAstronaut}
          formats={["avif"]}
          loading="eager"
          alt="An astronaut floating in space"
          class="h-full w-full object-contain"
          onerror="this.closest('[data-404-illustration]')?.remove()"
        />
      </div>
      <h1
        class="mt-5 text-4xl font-bold tracking-tight text-foreground sm:mt-8 sm:text-5xl"
      >
        Oops, page not found!
      </h1>
      <p class="mt-4 text-muted-foreground">
        The page you're looking for doesn't exist or has not been published yet.
      </p>
      <div class="mt-6">
        <a
          class="inline-flex items-center rounded-md bg-primary px-4 py-2 text-sm font-medium text-primary-foreground shadow-sm transition-colors hover:bg-primary/90 focus:outline-none focus:ring-2 focus:ring-primary focus:ring-offset-2"
          href="/"
          rel="ugc"
        >
          Go to Homepage
        </a>
      </div>
    </div>
  </div>
</StarLayout>
