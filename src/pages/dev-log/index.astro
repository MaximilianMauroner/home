---
import LogPreview from "@/components/content/LogPreview";
import PostImageLoader from "@/components/content/PostImageLoader.astro";
import StarLayout from "@/layouts/StarLayout.astro";
import "@/layouts/LogLayout.css";
import { serializeJsonLd } from "@/utils/server/seo";
import { getLogs } from "@/utils/server/content";

const logs = await getLogs();
const [latest, ...earlier] = logs;
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: Astro.site },
    { "@type": "ListItem", position: 2, name: "Dev Log", item: new URL("/dev-log/", Astro.site).href },
  ],
};
---

<StarLayout title="Dev log" description="Things I’m building. Things I’m figuring out. A development log by Max Mauroner.">
  <script is:inline type="application/ld+json" set:html={serializeJsonLd(breadcrumbSchema)} />
  <section class="log-editorial">
    <div class="log-shell">
      <header class="log-intro">
        <h1>Dev log<span>.</span></h1>
        <p>Things I’m building.<br />Things I’m figuring out.</p>
      </header>
      {latest && (
        <article class="log-feature">
          {latest.data.image && <a class="log-feature__image" href={`/dev-log/${latest.id}/`} aria-label={`Read ${latest.data.title}`}><PostImageLoader imagePath={latest.data.image} altText={latest.data.title} /></a>}
          <div class="log-feature__copy">
            <div class="log-meta"><time datetime={new Date(latest.data.releaseDate).toISOString()}>{new Date(latest.data.releaseDate).toLocaleDateString("en-GB", { day: "numeric", month: "long", year: "numeric", timeZone: "UTC" })}</time><span>{latest.id.replace("/", " / ")}</span></div>
            <h2><a href={`/dev-log/${latest.id}/`} transition:name={`devlog-title-${latest.id.replaceAll("/", "-")}`}>{latest.data.title}</a></h2>
            <a class="log-feature__link" href={`/dev-log/${latest.id}/`}>Read this entry <span aria-hidden="true">↗</span></a>
          </div>
        </article>
      )}
      {earlier.length > 0 && <><div class="log-section-heading"><h2>Earlier entries</h2><span>Work in progress, recorded.</span></div><div class="log-entries">{earlier.map(log => <LogPreview log={log} />)}</div></>}
      {!latest && <p>No entries yet.</p>}
      <footer class="log-archive-footer"><span>{logs.length} entries</span><a href="/rss.xml">Follow via RSS ↗</a></footer>
    </div>
  </section>
</StarLayout>
