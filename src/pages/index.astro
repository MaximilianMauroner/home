---
import { getBlogs, getLogs, getSnacks } from "@/utils/server/content";
import Homepage from "@/components/home/Homepage";
import StarLayout from "@/layouts/StarLayout.astro";
import dayjs from "dayjs";
import type { PreviewEntry } from "@/components/content/previewTypes";
const blogs = await getBlogs();
const logs = await getLogs();
const snacks = await getSnacks();
type PreviewSource =
  | (typeof blogs)[number]
  | (typeof logs)[number]
  | (typeof snacks)[number];
const toPreviewEntry = (entry: PreviewSource): PreviewEntry => ({
  id: entry.id,
  data: {
    title: entry.data.title,
    description: entry.data.description,
    tags: entry.data.tags,
    type: entry.data.type,
    image: entry.data.image,
    releaseDate: entry.data.releaseDate.toISOString(),
  },
});
const blogPreviews = blogs.map(toPreviewEntry);
const logPreviews = logs.map(toPreviewEntry);
const snackPreviews = snacks.map(toPreviewEntry);
const initialAge =
  dayjs().diff(dayjs("2000-03-13T04:00:00Z"), "year").toString();
---

<StarLayout
  title="Maximilian Mauroner — Software Developer & Builder"
  description="Software developer studying at TU Wien, sharing open-source tools, engineering notes, experiments, and practical articles."
>
  <h1 class="sr-only">Maximilian Mauroner — Software Developer & Builder</h1>
  <Homepage
    blogs={blogPreviews}
    logs={logPreviews}
    snacks={snackPreviews}
    initialAge={initialAge}
    client:load
  />
</StarLayout>
