---
/** Adds the Max effort runs back into a figure. Hidden until the figure's script connects it with bindMaxToggle. */
---

<div class="sp-max-toggle" data-max-toggle hidden>
  <span>Max effort</span>
  <div class="sp-trend" role="group" aria-label="Max effort">
    <button type="button" data-max-value="false" aria-pressed="true">Off</button>
    <button type="button" data-max-value="true" aria-pressed="false">On</button>
  </div>
</div>
