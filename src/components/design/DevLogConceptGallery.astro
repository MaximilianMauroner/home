---
import type { CollectionEntry } from "astro:content";
import PostImageLoader from "@/components/content/PostImageLoader.astro";

interface Concept {
  name: string;
  variant: string;
  motif: string;
}

interface ConceptGroup {
  source: string;
  concepts: readonly Concept[];
}

interface Props {
  log: CollectionEntry<"log">;
  groups: readonly ConceptGroup[];
  startIndex?: number;
}

const { log, groups, startIndex = 6 } = Astro.props;
const imagePath = log.data.image?.trim() || null;
const releaseDate = new Date(log.data.releaseDate);
const fullDate = releaseDate.toLocaleDateString("en-US", {
  year: "numeric",
  month: "short",
  day: "numeric",
  timeZone: "UTC",
});
const isoDate = releaseDate.toISOString();
const href = `/dev-log/${log.id}/`;
const entryId = log.id.split("/").filter(Boolean).at(-1) ?? "—";
const [year = "—", issue = entryId] = log.id.split("/");
let conceptIndex = startIndex;
---

<div class="generated-gallery">
  {
    groups.map((group) => (
      <section class="source-group" aria-label={`${group.source} concepts`}>
        <header class="source-heading">
          <span>{group.source}</span>
          <strong>Five focused variations</strong>
        </header>
        <div class="concept-list">
          {group.concepts.map((concept) => {
            const number = String(conceptIndex++).padStart(2, "0");
            return (
              <section class="concept-section" aria-labelledby={`concept-${number}`}>
                <div class="concept-label">
                  <span>{number} · {group.source}</span>
                  <h2 id={`concept-${number}`}>{concept.name}</h2>
                </div>
                <article class={`concept-card ${concept.variant}`}>
                  <div class="concept-decoration" aria-hidden="true">
                    <i></i><i></i><i></i><i></i><i></i>
                  </div>
                  <header class="concept-meta">
                    <span>DEV / {year}.{issue}</span>
                    <time datetime={isoDate}>{fullDate}</time>
                  </header>
                  <div class="concept-visual" aria-hidden="true">
                    {imagePath ? (
                      <PostImageLoader
                        imagePath={imagePath}
                        altText=""
                        className="h-full w-full object-cover"
                      />
                    ) : (
                      <strong>{year.slice(-2)} / {issue}</strong>
                    )}
                  </div>
                  <div class="concept-copy">
                    <span class="concept-kicker">{concept.motif}</span>
                    <h3><a href={href}>{log.data.title}</a></h3>
                    <p>{log.data.description}</p>
                    <ul aria-label="Topics">
                      {log.data.tags.map((tag, index) => (
                        <li style={`--tag-index:${index}`}>{tag}</li>
                      ))}
                    </ul>
                    <footer>
                      <span>{entryId.padStart(2, "0")} / {year}</span>
                      <span aria-hidden="true">Open entry ↗</span>
                    </footer>
                  </div>
                </article>
              </section>
            );
          })}
        </div>
      </section>
    ))
  }
</div>

<style>
  .generated-gallery { margin-top: 6rem; }
  .source-group { margin-top: 9rem; }
  .source-group:first-child { margin-top: 0; }
  .source-heading {
    display: flex; align-items: end; justify-content: space-between; gap: 1rem;
    padding-bottom: 1rem; border-bottom: 1px solid rgb(212 212 216);
  }
  .source-heading span, .concept-label span {
    color: rgb(79 70 229); font: 750 .66rem "JetBrains_Mono", monospace;
    letter-spacing: .16em; text-transform: uppercase;
  }
  .source-heading strong { font-size: clamp(1.3rem, 4vw, 2rem); letter-spacing: -.04em; }
  .concept-section { margin-top: 6rem; }
  .concept-label { margin-bottom: 1rem; }
  .concept-label h2 { margin-top: .25rem; font-size: 1.45rem; font-weight: 680; letter-spacing: -.035em; }

  .concept-card {
    --card-accent: #4f46e5; --card-surface: #fff; --card-ink: #18181b; --card-muted: #52525b; --card-line: #d4d4d8;
    position: relative; isolation: isolate; display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(12rem, .8fr);
    min-height: 25rem; max-width: 68rem; overflow: hidden;
    border: 1px solid var(--card-line); border-radius: var(--radius-lg);
    background: var(--card-surface); color: var(--card-ink);
  }
  .concept-meta {
    position: absolute; z-index: 5; top: 0; left: 0; right: 0;
    display: flex; justify-content: space-between; gap: 1rem; padding: .8rem 1rem;
    border-bottom: 1px solid var(--card-line); color: var(--card-muted);
    font: 700 .62rem "JetBrains_Mono", monospace; letter-spacing: .12em; text-transform: uppercase;
  }
  .concept-visual { position: relative; grid-column: 2; min-height: 25rem; overflow: hidden; border-left: 1px solid var(--card-line); background: color-mix(in srgb, var(--card-accent) 12%, var(--card-surface)); }
  .concept-visual :global(img) { height: 100%; width: 100%; object-fit: cover; transition: transform 280ms ease, filter 280ms ease; }
  .concept-copy { z-index: 2; display: flex; min-width: 0; flex-direction: column; grid-column: 1; grid-row: 1; padding: 4.5rem 2rem 1.6rem; }
  .concept-kicker { color: var(--card-accent); font: 750 .65rem "JetBrains_Mono", monospace; letter-spacing: .14em; text-transform: uppercase; }
  .concept-copy h3 { max-width: 16ch; margin-top: 1rem; font-size: clamp(2rem, 5vw, 3.5rem); font-weight: 740; line-height: .98; letter-spacing: -.055em; }
  .concept-copy h3 a:hover { color: var(--card-accent); }
  .concept-copy p { max-width: 52ch; margin-top: 1rem; color: var(--card-muted); line-height: 1.65; }
  .concept-copy ul { display: flex; flex-wrap: wrap; gap: .45rem; margin-top: 1.25rem; }
  .concept-copy li { padding: .3rem .5rem; border: 1px solid var(--card-line); font: 700 .62rem "JetBrains_Mono", monospace; text-transform: uppercase; }
  .concept-copy footer { display: flex; align-items: end; justify-content: space-between; gap: 1rem; margin-top: auto; padding-top: 1.25rem; border-top: 1px solid var(--card-line); color: var(--card-muted); font: 750 .64rem "JetBrains_Mono", monospace; letter-spacing: .08em; text-transform: uppercase; }
  .concept-copy footer span:last-child { color: var(--card-accent); }
  .concept-decoration { position: absolute; inset: 0; z-index: -1; pointer-events: none; }
  .concept-decoration i { position: absolute; display: block; }
  .concept-card:hover .concept-visual :global(img) { transform: scale(1.025); }
  .concept-card a:focus-visible { outline: 3px solid var(--card-accent); outline-offset: 4px; border-radius: 2px; }

  /* 06 — landscape route map */
  .topographic-route { --card-surface:#ece8d4; --card-ink:#23352c; --card-muted:#55675d; --card-line:#89998d; --card-accent:#ef5b36; background-image: repeating-radial-gradient(ellipse at 90% 20%, transparent 0 22px, rgb(35 53 44 / .13) 23px 24px); }
  .topographic-route .concept-visual { margin: 3.5rem 1rem 1rem 0; min-height: 20rem; clip-path: polygon(8% 2%,100% 0,96% 88%,70% 100%,5% 92%,0 30%); border: 0; }
  .topographic-route .concept-copy li { position: relative; border: 0; padding-left: 1.2rem; }
  .topographic-route .concept-copy li::before { content:""; position:absolute; left:0; top:50%; width:.65rem; aspect-ratio:1; border:2px solid var(--card-accent); border-radius:50%; transform:translateY(-50%); }
  .topographic-route .concept-decoration i:first-child { left:8%; right:8%; bottom:4rem; height:3px; background:var(--card-accent); rotate:-5deg; }

  /* 07 — radial dispatch */
  .orbital-dispatch { --card-surface:#f5f0e5; --card-ink:#171b4b; --card-muted:#50547b; --card-line:#9ba4dd; --card-accent:#3158d8; grid-template-columns: 42% 58%; }
  .orbital-dispatch .concept-visual { grid-column:1; grid-row:1; align-self:center; width:17rem; min-height:17rem; margin:3rem auto 1rem; border:1px solid var(--card-accent); border-radius:50%; }
  .orbital-dispatch .concept-copy { grid-column:2; padding-left:1rem; }
  .orbital-dispatch .concept-decoration i:nth-child(1), .orbital-dispatch .concept-decoration i:nth-child(2) { left:4%; top:13%; width:42%; aspect-ratio:1; border:1px dashed var(--card-accent); border-radius:50%; }
  .orbital-dispatch .concept-decoration i:nth-child(2) { scale:1.25 .65; }
  .orbital-dispatch .concept-copy li { border-radius:999px; }

  /* 08 — modular patch panel */
  .patchbay-memo { --card-surface:#242421; --card-ink:#f3e9cc; --card-muted:#beb49c; --card-line:#5e5d54; --card-accent:#ff4e38; grid-template-columns:repeat(3,1fr); padding:3.6rem .9rem .9rem; gap:.6rem; background-image:repeating-linear-gradient(90deg,transparent 0 3px,#ffffff05 3px 4px); }
  .patchbay-memo .concept-meta { background:#141413; }
  .patchbay-memo .concept-visual { grid-column:3; grid-row:1; min-height:20rem; border:2px inset #5e5d54; border-radius:.4rem; }
  .patchbay-memo .concept-copy { grid-column:1 / 3; padding:1.4rem; border:2px inset #5e5d54; background:#1b1b19; }
  .patchbay-memo .concept-copy li { padding-left:1.5rem; border:0; background:radial-gradient(circle at .55rem 50%,#111 0 4px,#eee 4px 6px,transparent 6px); }
  .patchbay-memo .concept-copy footer span:last-child { padding:.7rem 1rem; border:1px solid #ff4e38; background:#4a1711; }

  /* 09 — three folded chart panels */
  .foldout-atlas { --card-surface:#f4e8c5; --card-ink:#142d4f; --card-muted:#435873; --card-line:#142d4f; --card-accent:#df553d; grid-template-columns:30% 40% 30%; }
  .foldout-atlas .concept-visual { grid-column:1; grid-row:1; border:0; filter:saturate(.75); }
  .foldout-atlas .concept-copy { grid-column:2 / 4; margin-top:3rem; padding:1.5rem; background-image:linear-gradient(#315a8b17 1px,transparent 1px),linear-gradient(90deg,#315a8b17 1px,transparent 1px); background-size:2rem 2rem; box-shadow:inset 12px 0 16px -16px #142d4f,inset -12px 0 16px -16px #142d4f; }
  .foldout-atlas .concept-copy ul { display:grid; grid-template-columns:1fr 1fr; }
  .foldout-atlas .concept-copy li { border:0; }

  /* 10 — cassette object */
  .field-cassette { --card-surface:#c8ed6f; --card-ink:#132315; --card-muted:#3e5439; --card-line:#132315; --card-accent:#e3442c; margin-inline:auto; max-width:58rem; min-height:27rem; grid-template-columns:1fr; padding:4rem 2rem 1.5rem; border:8px solid #252923; border-radius:2rem; box-shadow:inset 0 0 0 3px #ffffff55; }
  .field-cassette .concept-meta { top:.8rem; left:1rem; right:1rem; border:0; }
  .field-cassette .concept-visual { grid-column:1; grid-row:1; width:58%; min-height:9rem; max-height:9rem; margin:8.5rem auto 0; border:7px solid #e8e7d8; border-radius:4.5rem; clip-path:polygon(8% 0,92% 0,100% 100%,0 100%); }
  .field-cassette .concept-copy { grid-column:1; grid-row:1; padding:0; }
  .field-cassette .concept-copy h3 { max-width:20ch; font-size:2.3rem; }
  .field-cassette .concept-copy p { max-width:38rem; }
  .field-cassette .concept-copy ul { margin-top:auto; padding-top:1rem; border-top:3px solid; }
  .field-cassette .concept-copy footer { border:0; }
  .field-cassette .concept-decoration i:nth-child(-n+4) { width:.7rem; aspect-ratio:1; border:2px solid; border-radius:50%; }
  .field-cassette .concept-decoration i:nth-child(1){left:1rem;top:1rem}.field-cassette .concept-decoration i:nth-child(2){right:1rem;top:1rem}.field-cassette .concept-decoration i:nth-child(3){left:1rem;bottom:1rem}.field-cassette .concept-decoration i:nth-child(4){right:1rem;bottom:1rem}

  /* 11 — oscilloscope rack */
  .patchbay-release { --card-surface:#090c0a; --card-ink:#d9ffe4; --card-muted:#81a98d; --card-line:#31543b; --card-accent:#7cff45; grid-template-columns:minmax(0,1fr) 38%; background-image:repeating-linear-gradient(0deg,transparent 0 4px,#ffffff05 4px 5px); }
  .patchbay-release .concept-visual { align-self:center; width:18rem; min-height:18rem; margin:3.5rem auto 1rem; border:8px solid #28342b; border-radius:50%; filter:grayscale(1) contrast(1.3) sepia(.3) hue-rotate(55deg); }
  .patchbay-release .concept-copy li { border:0; border-radius:999px; padding-left:1.7rem; background:radial-gradient(circle at .7rem,#101512 0 4px,#b9c4bc 4px 6px,transparent 6px); }
  .patchbay-release .concept-kicker::before { content:"● "; color:#ff3b30; }

  /* 12 — transit map */
  .metro-merge { --card-surface:#f5ead1; --card-ink:#152b50; --card-muted:#566277; --card-line:#152b50; --card-accent:#e64f32; grid-template-columns:28% 72%; }
  .metro-merge .concept-visual { grid-column:1; grid-row:1; align-self:center; width:12rem; min-height:12rem; margin:3rem auto 1rem; border:10px solid #f5ead1; outline:6px solid var(--card-accent); border-radius:50%; }
  .metro-merge .concept-copy { grid-column:2; padding-left:2.5rem; }
  .metro-merge .concept-copy::before { content:""; position:absolute; left:24%; right:4%; top:52%; z-index:-1; height:8px; background:var(--card-accent); }
  .metro-merge .concept-copy li { border-radius:999px; background:var(--card-surface); border:4px solid var(--card-accent); }

  /* 13 — layered technical schematic */
  .exploded-blueprint { --card-surface:#073a66; --card-ink:#e8f8ff; --card-muted:#a8d4ea; --card-line:#4b91bb; --card-accent:#ff9d38; grid-template-columns:45% 55%; background-image:linear-gradient(#ffffff12 1px,transparent 1px),linear-gradient(90deg,#ffffff12 1px,transparent 1px); background-size:1.5rem 1.5rem; overflow:visible; margin:1rem; }
  .exploded-blueprint .concept-visual { grid-column:1; grid-row:1; min-height:19rem; margin:4.5rem -1rem 2rem 2rem; border:1px solid #8ed4ff; box-shadow:-12px 12px 0 #0c4c7b; opacity:.78; }
  .exploded-blueprint .concept-copy { grid-column:2; margin:5.5rem 1.2rem 1.2rem -1rem; padding:1.5rem; border:1px solid #8ed4ff; background:#073a66e8; box-shadow:12px -12px 0 #0c4c7b; }
  .exploded-blueprint .concept-copy li::before { content:counter(list-item,decimal-leading-zero) " "; color:var(--card-accent); }

  /* 14 — split astronomy index */
  .orbit-index { --card-surface:#07101f; --card-ink:#e9f6ff; --card-muted:#9ab0c4; --card-line:#344b62; --card-accent:#58d8ff; grid-template-columns:58% 42%; background-image:radial-gradient(circle,#fff 0 1px,transparent 1.5px); background-size:37px 43px; }
  .orbit-index .concept-visual { grid-column:1; grid-row:1; align-self:center; width:19rem; min-height:19rem; margin:3.5rem auto 1rem; border:1px solid #58d8ff; border-radius:50%; box-shadow:0 0 0 2.5rem #07101f,0 0 0 calc(2.5rem + 1px) #344b62; }
  .orbit-index .concept-copy { grid-column:2; padding-left:1rem; }
  .orbit-index .concept-copy li { border-radius:999px; }

  /* 15 — fanned execution frames */
  .cascading-stack { --card-surface:#f5f4ef; --card-ink:#18181b; --card-muted:#57535e; --card-line:#25232a; --card-accent:#5b42e8; margin:2rem; overflow:visible; box-shadow:-12px -12px 0 #44d7d0,12px 12px 0 #b8f23e,22px 22px 0 #ff7a45; transform:rotate(-.5deg); }
  .cascading-stack .concept-visual { margin:1rem; min-height:22rem; transform:rotate(2deg) translate(8px,-8px); border:3px solid #25232a; }
  .cascading-stack .concept-copy { margin:1rem; border:3px solid #25232a; background:#f5f4ef; }
  .cascading-stack:hover { box-shadow:-18px -18px 0 #44d7d0,18px 18px 0 #b8f23e,30px 30px 0 #ff7a45; }

  /* 16 — broadcast signal monitor */
  .signal-monitor { --card-surface:#07130e; --card-ink:#d8ffe7; --card-muted:#82b491; --card-line:#315441; --card-accent:#67ff9b; grid-template-columns:42% 58%; border-radius:0; }
  .signal-monitor .concept-visual { grid-column:1; grid-row:1; margin-top:2.5rem; filter:grayscale(1) contrast(1.25) sepia(.2) hue-rotate(70deg); }
  .signal-monitor .concept-copy { grid-column:2; padding-left:2rem; border-left:1px solid var(--card-line); }
  .signal-monitor .concept-copy li { display:grid; grid-template-columns:1.5rem 1fr; width:100%; border-width:1px 0 0; }
  .signal-monitor .concept-decoration { background:repeating-linear-gradient(0deg,transparent 0 3px,#67ff9b0d 3px 4px); }
  .signal-monitor .concept-kicker::before { content:"● "; text-shadow:0 0 12px #67ff9b; }

  /* 17 — scientific specimen slide */
  .specimen-slide { --card-surface:#eef5d8; --card-ink:#153f37; --card-muted:#41675f; --card-line:#153f37; --card-accent:#d45132; grid-template-columns:40% 60%; border-radius:0; box-shadow:inset 0 0 0 .45rem #dce8bd; }
  .specimen-slide .concept-visual { grid-column:1; grid-row:1; align-self:center; width:18rem; min-height:18rem; margin:3.5rem auto 1rem; border:.7rem solid #f8fae9; outline:1px solid #153f37; border-radius:50%; box-shadow:0 1rem 2.5rem #315d3b30; }
  .specimen-slide .concept-copy { grid-column:2; }
  .specimen-slide .concept-copy h3 { font-family:Georgia,serif; font-weight:600; font-size:clamp(2.3rem,6vw,4.3rem); }
  .specimen-slide .concept-copy li { display:grid; grid-template-columns:1.2rem 1fr; border-width:0 0 1px; }
  .specimen-slide .concept-copy li::before { content:counter(list-item,upper-alpha); color:var(--card-accent); }

  /* 18 — git commit graph */
  .commit-graph { --card-surface:#f4f2ed; --card-ink:#201f1b; --card-muted:#5f5b52; --card-line:#201f1b; --card-accent:#ff5b37; grid-template-columns:5rem minmax(0,1fr) 32%; border-radius:0; box-shadow:6px 6px 0 #201f1b; }
  .commit-graph .concept-visual { grid-column:3; grid-row:1; margin:3.5rem 1rem 1rem; min-height:20rem; border:1px solid; }
  .commit-graph .concept-copy { grid-column:2; padding-left:1rem; }
  .commit-graph .concept-decoration i:nth-child(1) { left:2.5rem; top:0; bottom:0; width:3px; background:var(--card-accent); }
  .commit-graph .concept-decoration i:nth-child(n+2) { left:2rem; width:1rem; aspect-ratio:1; border:3px solid var(--card-accent); border-radius:50%; background:var(--card-surface); }
  .commit-graph .concept-decoration i:nth-child(2){top:25%}.commit-graph .concept-decoration i:nth-child(3){top:50%;background:var(--card-accent)}.commit-graph .concept-decoration i:nth-child(4){top:75%}
  .commit-graph .concept-copy li::before { content:"+ "; color:#008a4b; }

  /* 19 — overlapping desktop windows */
  .window-manager { --card-surface:#8ba9ff; --card-ink:#171717; --card-muted:#4c4c4c; --card-line:#171717; --card-accent:#3726c7; display:block; min-height:34rem; border-radius:0; }
  .window-manager .concept-visual { position:absolute; inset:3.5rem 31% 5rem 2rem; min-height:0; border:1px solid; box-shadow:8px 8px 0 #17171735; }
  .window-manager .concept-visual::before { content:"●  ●  ●    preview.img"; position:absolute; z-index:2; inset:0 0 auto; height:2rem; padding:.55rem; border-bottom:1px solid; background:#ece9df; font:.62rem "JetBrains_Mono",monospace; }
  .window-manager .concept-copy { position:absolute; right:2rem; bottom:4rem; width:min(57%,34rem); min-height:20rem; padding:3.3rem 2rem 1.5rem; border:1px solid; background:#f8f5ec; box-shadow:8px 8px 0 #17171735; }
  .window-manager .concept-copy::before { content:"entry.txt                         — □ ×"; position:absolute; inset:0 0 auto; height:2rem; padding:.55rem; border-bottom:1px solid; background:#ece9df; font:.62rem "JetBrains_Mono",monospace; }
  .window-manager .concept-meta { top:auto; bottom:0; background:#171717; color:#fff; }

  /* 20 — accordion navigation chart */
  .accordion-dispatch { --card-surface:#f7edcf; --card-ink:#172a4a; --card-muted:#526078; --card-line:#172a4a; --card-accent:#e85e3f; grid-template-columns:22% 34% 44%; border-radius:0; }
  .accordion-dispatch .concept-meta { right:auto; bottom:0; width:22%; flex-direction:column; justify-content:flex-end; background:#e85e3f; color:#fff; border:0; }
  .accordion-dispatch .concept-visual { grid-column:2; grid-row:1; min-height:28rem; border-inline:1px solid; }
  .accordion-dispatch .concept-copy { grid-column:3; padding-left:1.4rem; background-image:linear-gradient(#315a8b18 1px,transparent 1px),linear-gradient(90deg,#315a8b18 1px,transparent 1px); background-size:2rem 2rem; box-shadow:inset 12px 0 16px -16px #172a4a; }

  /* 21 — full-card contour plate */
  .contour-plate { --card-surface:#fafaf9; --card-ink:#292524; --card-muted:#66615e; --card-line:#a8a29e; --card-accent:#4f46e5; display:block; min-height:24rem; background-image:repeating-radial-gradient(ellipse at 85% 20%,transparent 0 26px,#29252418 27px 28px); }
  .contour-plate .concept-visual { position:absolute; z-index:1; top:3.6rem; right:1.5rem; width:10rem; min-height:10rem; border:1px dashed; border-radius:50%; }
  .contour-plate .concept-copy { position:absolute; inset:auto 0 0; max-width:70%; background:linear-gradient(90deg,#fafaf9 75%,transparent); }
  .contour-plate .concept-copy h3 { font-size:clamp(2rem,5vw,3.8rem); }

  /* 22 — single graph node with connective rail */
  .commit-rail { --card-surface:#fff; --card-ink:#18181b; --card-muted:#52525b; --card-line:#d4d4d8; --card-accent:#4f46e5; grid-template-columns:4rem minmax(0,1fr) 7rem; min-height:18rem; overflow:visible; margin-left:1rem; }
  .commit-rail .concept-visual { grid-column:3; grid-row:1; min-height:7rem; height:7rem; margin:4rem 1rem 0 0; border-radius:var(--radius-md); }
  .commit-rail .concept-copy { grid-column:2; padding-left:1rem; }
  .commit-rail .concept-copy h3 { font-size:2.3rem; }
  .commit-rail .concept-decoration i:first-child { left:1.4rem; top:-6rem; bottom:-6rem; width:2px; background:var(--card-line); }
  .commit-rail .concept-decoration i:nth-child(2) { left:.98rem; top:5.2rem; width:.9rem; aspect-ratio:1; border-radius:50%; background:var(--card-accent); box-shadow:0 0 0 5px var(--card-surface); }
  .commit-rail .concept-copy li { border-radius:999px; }

  /* 23 — unified diff */
  .patch-file { --card-surface:#fafafa; --card-ink:#27272a; --card-muted:#52525b; --card-line:#a1a1aa; --card-accent:#7c3aed; grid-template-columns:1fr; min-height:22rem; border-radius:var(--radius-md); font-family:"JetBrains_Mono",monospace; }
