---
const navigation = [
  { name: "Home", href: "/" },
  { name: "Dev log", href: "/dev-log/" },
  { name: "Blog", href: "/blog/" },
  { name: "Snacks", href: "/snacks/" },
  { name: "Tools", href: "/tools/" },
  { name: "Tags", href: "/tags/" },
  { name: "Privacy", href: "/privacy/" },
];

const linkClass =
  "inline-flex min-h-11 items-center rounded-md px-2 font-medium underline-offset-4 hover:underline focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-foreground";
---

<footer
  transition:persist="site-footer"
  class="border-t border-border bg-muted/60 px-4 py-6 text-foreground backdrop-blur-sm sm:px-6"
>
  <div class="mx-auto flex max-w-screen-xl flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
    <div class="flex flex-col gap-2">
      <nav aria-label="Footer navigation">
        <ul class="flex flex-wrap items-center gap-x-1">
          {
            navigation.map((item) => (
              <li>
                <a href={item.href} class={linkClass}>{item.name}</a>
              </li>
            ))
          }
        </ul>
      </nav>
      <p class="text-sm opacity-80">
        &copy; {new Date().getUTCFullYear()} Maximilian Mauroner
      </p>
    </div>

    <div class="flex flex-wrap items-center gap-x-1 text-sm">
      <a href="mailto:home@relay.mauroner.net" rel="nofollow" class={linkClass}>
        Email
      </a>
      <a
        href="https://github.com/MaximilianMauroner/home"
        target="_blank"
        rel="noreferrer"
        class={linkClass}
      >
        Source
      </a>
    </div>
  </div>
</footer>
