---
import { authorPerson } from "@/utils/authorIdentity";
---

<span class="article-author">By <a rel="author" href="/">{authorPerson.name}</a></span>

<style>
  .article-author {
    white-space: nowrap;
  }

  .article-author a {
    color: inherit;
    text-decoration: none;
  }

  .article-author a:hover,
  .article-author a:focus-visible {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
</style>
