---
import { serializeJsonLd } from "@/utils/server/seo";
import { getArticleOgImageUrl } from "@/utils/server/content";
import { authorPerson } from "@/utils/authorIdentity";

interface Props {
  description?: string;
  modifiedAt?: string;
  publishedAt: string;
  sectionName: string;
  sectionPath: string;
  tags: string[];
  title: string;
}

const {
  description = "",
  modifiedAt,
  publishedAt,
  sectionName,
  sectionPath,
  tags,
  title,
} = Astro.props;
// Match the canonical URL, which always ends with a slash.
const pathname = Astro.url.pathname.replace(/\/?$/, "/");
const pageUrl = new URL(pathname, Astro.site).href;
const imageUrl = getArticleOgImageUrl(pathname, Astro.site);
const articleSchema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: title,
  description,
  keywords: tags.join(", "),
  url: pageUrl,
  image: {
    "@type": "ImageObject",
    url: imageUrl,
    width: 1200,
    height: 630,
  },
  author: authorPerson,
  publisher: authorPerson,
  dateModified: modifiedAt,
  datePublished: publishedAt,
  mainEntityOfPage: { "@type": "WebPage", "@id": pageUrl },
};
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Home",
      item: new URL("/", Astro.site).href,
    },
    {
      "@type": "ListItem",
      position: 2,
      name: sectionName,
      item: new URL(sectionPath, Astro.site).href,
    },
    { "@type": "ListItem", position: 3, name: title, item: pageUrl },
  ],
};
---

<script
  is:inline
  type="application/ld+json"
  set:html={serializeJsonLd(articleSchema)}
></script>
<script
  is:inline
  type="application/ld+json"
  set:html={serializeJsonLd(breadcrumbSchema)}
></script>
